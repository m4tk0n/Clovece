# Environment file (contains sensitive data - DO NOT COMMIT REAL CREDENTIALS)
# Template file .env.dist is committed and should be renamed to .env on server
.env

# IDE files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Log files
*.log

# Cache
*.cache
/cache/

# Sessions
sessions/

# Temporary files
*.tmp
*.temp

# Composer (if used)
vendor/
composer.lock

# Node (if used)
node_modules/
package-lock.json
