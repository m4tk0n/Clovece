# ============================================
# Člověče, nezlob se! - Git Ignore
# ============================================

# Environment files may contain production credentials.
# Commit only the safe template .env.dist, never the real .env.
.env

# IDE files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Log files
*.log

# Cache
*.cache
/cache/

# Sessions
sessions/

# Temporary files
*.tmp
*.temp

# Composer (if used)
vendor/
composer.lock

# Node (if used)
node_modules/
package-lock.json

# Playwright browser test output
playwright-report/
test-results/

# AI training reports and local experiment output
artifacts/

# Server-side human feedback weights (private runtime state)
/ai-learned-weights.json
/.ai-learned-weights.lock
