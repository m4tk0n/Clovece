# /.env.dist
# ============================================
# Člověče, nezlob se! - Environment Configuration Template
# 
# INSTRUCTIONS:
# 1. Copy this file to .env on your server
# 2. Fill in your actual database credentials
# 3. DO NOT commit .env to version control
# 
# cp .env.dist .env
# nano .env  # edit with your credentials
# ============================================

# Database Configuration
DB_HOST=localhost
DB_USER=username
DB_PASS=password
DB_NAME=clovece_game
TABLE_PREFIX=clovece_

# Site Configuration
SITE_NAME="Člověče, nezlob se!"
SITE_URL="https://tvujweb.wz.cz/clovece"

# Security
# Dedicated token for triggering the read-only FTP audit endpoint.
# Generate a unique random value of at least 40 characters.
FTP_AUDIT_TRIGGER_TOKEN=CHANGE_ME_use_a_long_random_secret
# Fine-grained GitHub token restricted to m4tk0n/Clovece with Actions: write.
GITHUB_ACTIONS_TOKEN=CHANGE_ME_github_fine_grained_token
CSRF_TOKEN_NAME=clovece_csrf_token
SESSION_TIMEOUT=3600
# Povinné pro /cron/cron.php; vygeneruj vlastní náhodný klíč (alespoň 32 znaků).
# Například: bin2hex(random_bytes(32))
CRON_SECRET=CHANGE_ME_generate_a_unique_random_secret_before_use

# Error Reporting (1 = on, 0 = off)
DISPLAY_ERRORS=0
ERROR_REPORTING=E_ALL

# Timezone
TIMEZONE=Europe/Prague
